# Directus CMS — Admin dashboard for Olive App
# Copy this to .env and fill in the values

# Encryption keys (generate with: openssl rand -hex 32)
KEY=replace-with-random-256-bit-hex
SECRET=replace-with-another-random-256-bit-hex

# Admin account (created on first boot)
ADMIN_EMAIL=admin@olivepath.org
ADMIN_PASSWORD=change-me

# Database — same MySQL as the Express backend
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=olive_path
DB_USER=root
DB_PASSWORD=

# Public URL (for Render deployment)
PUBLIC_URL=http://localhost:8055
